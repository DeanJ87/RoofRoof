{
  "about": "Every HTTP route the device serves (src/WebServer.cpp) with its auth. Checked by tools/api/routes.py. 'required' = needs the password when protection is on (docs/user-guide/security.md); open routes say why.",
  "routes": [
    { "path": "$probe", "method": "GET", "auth": "open", "why": "Captive-portal probes from phones and laptops: redirect to the setup screen, change nothing" },
    { "path": "/api/status", "method": "GET", "auth": "open", "why": "Read-only status for integrations" },
    { "path": "/api/settings/effective", "method": "GET", "auth": "open", "why": "Read-only effective-settings report (no secrets)" },
    { "path": "/api/config", "method": "GET", "auth": "open", "why": "Read-only, every secret masked" },
    { "path": "/api/config", "method": "POST|PUT", "auth": "required" },
    { "path": "/api/restart", "method": "POST", "auth": "required" },
    { "path": "/api/roof/open", "method": "POST", "auth": "required" },
    { "path": "/api/roof/close", "method": "POST", "auth": "required" },
    { "path": "/api/roof/stop", "method": "POST", "auth": "required" },
    { "path": "/api/roof/clear-fault", "method": "POST", "auth": "required" },
    { "path": "/api/backup/preview", "method": "POST", "auth": "required" },
    { "path": "/api/backup/apply", "method": "POST", "auth": "required" },
    { "path": "/api/backup", "method": "POST", "auth": "required" },
    { "path": "/api/wifi/scan", "method": "GET", "auth": "required" },
    { "path": "/api/mqtt/test", "method": "POST", "auth": "required" },
    { "path": "/api/wifi/connect", "method": "POST", "auth": "required" },
    { "path": "/api/update/fs", "method": "POST", "auth": "required" },
    { "path": "/api/update", "method": "POST", "auth": "required" },
    { "path": "/api/alerts/test", "method": "POST", "auth": "required" },
    { "path": "/api/alerts/clear", "method": "POST", "auth": "required" },
    { "path": "/api/alerts/arm", "method": "POST", "auth": "required" },
    { "path": "/api/alerts/disarm", "method": "POST", "auth": "required" },
    { "path": "/api/alerts/armed", "method": "GET", "auth": "open", "why": "Read-only: sending or paused, and why" },
    { "path": "/api/alerts/recent", "method": "GET", "auth": "open", "why": "Read-only recent alerts (no secrets)" },
    { "path": "/setup", "method": "GET", "auth": "open", "why": "Alpaca setup pages redirect to Settings; the Settings page itself asks for the password on save" },
    { "path": "/management", "method": "GET", "auth": "open", "why": "ASCOM Alpaca management API: the Alpaca spec has no auth" },
    { "path": "/api/v1", "method": "ANY", "auth": "open", "why": "ASCOM Alpaca device API: the Alpaca spec has no auth. The Dome's open and close pass the same weather and park checks as the REST commands, cannot move a roof of unknown position or clear a fault, and its stop is never refused (constitution I-III, VIII)" }
  ]
}
