{
  "deviceName": "RoofRoof",
  "wifi": {
    "ssid": "YourWiFiSSID",
    "password": "YourWiFiPassword",
    "hostname": "roofroof",
    "mdns": true,
    "ipv6": true,
    "autoReconnect": true,
    "reconnectDelayMs": 1000,
    "maxReconnectDelayMs": 300000
  },
  "ntp": {
    "enabled": true,
    "server1": "pool.ntp.org",
    "server2": "time.cloudflare.com",
    "timezone": "GMT0",
    "syncIntervalMs": 3600000
  },
  "mqtt": {
    "enabled": false,
    "broker": "mqtt.example.com",
    "port": 1883,
    "username": "",
    "password": "",
    "topic": "roofroof",
    "publishIntervalMs": 60000,
    "homeAssistant": { "enabled": false, "discoveryPrefix": "homeassistant" }
  },
  "ota": {
    "enabled": false,
    "password": ""
  },
  "auth": {
    "enabled": false,
    "username": "admin",
    "password": ""
  },
  "alpaca": { "enabled": true },
  "alerts": {
    "enabled": false,
    "events": {
      "client_lost": { "level": 3, "sound": "" },
      "client_back": { "level": 1, "sound": "" },
      "client_disconnected": { "level": 0, "sound": "" }
    },
    "sendMode": "any",
    "clientSilentSeconds": 120,
    "cooldownSeconds": 300,
    "pushover": { "enabled": false, "userKey": "", "appToken": "", "sound": "" },
    "ntfy": { "enabled": false, "server": "https://ntfy.sh", "topic": "", "token": "" },
    "webhook": { "enabled": false, "url": "", "authHeader": "", "insecureTls": false },
    "mqtt": { "enabled": false }
  }
